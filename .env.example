# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Proyecto: ekuxwmktzasyxvziijdz.supabase.co (ver docs/architecture.md)
NEXT_PUBLIC_SUPABASE_URL=https://ekuxwmktzasyxvziijdz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo en el servidor, nunca expuesta al cliente. No lleva prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── IA conversacional ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Aviso automático al asesor (M-05) ─────────────────────────────────────────
# Resend (ver docs/architecture.md → decisión 2026-08-27). Clave desde resend.com/api-keys.
RESEND_API_KEY=
# Email que recibe el aviso cuando un visitante completa el chat.
ADVISOR_NOTIFICATION_EMAIL=

# ─── Límite de uso por IP (protección contra abuso) ────────────────────────────
# Secreto para hashear la IP (HMAC-SHA256, ver docs/features/limite-de-uso.md). Cualquier cadena
# larga y aleatoria sirve — genera una con, p. ej., `openssl rand -hex 32`.
IP_HASH_PEPPER=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Credenciales que consumen los servidores declarados en .mcp.json.
# El servidor "supabase" usa OAuth (autenticación en el navegador vía /mcp): no necesita
# ninguna variable aquí.
